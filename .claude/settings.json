{
  "lspServers": {
    "python": {
      "command": "/Users/andreborczuk/app-foundation/.venv/bin/pyright-langserver",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/andreborczuk/app-foundation/.codex/hooks/session_start_context.py",
            "statusMessage": "Loading session notes and repo UV cache"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook_enforce_code_reads.py",
            "statusMessage": "Enforcing helper-only code/doc read policy..."
          },
          {
            "type": "command",
            "command": "python3 -c \"\nimport json, sys, re\ndata = json.load(sys.stdin)\ncmd = data.get('tool_input', {}).get('command', '').strip()\nfor m in re.finditer(r'(?<![a-zA-Z0-9_])(grep|rg)(\\\\s|$)', cmd):\n    pos = m.start()\n    before = cmd[:pos].rstrip()\n    if not before.endswith('|'):\n        print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse', 'permissionDecision': 'deny', 'permissionDecisionReason': 'Bash grep/rg is denied in this repo. For code reads use scripts/read_code.py (read_code_context/read_code_window/read_code_symbols); for markdown reads use scripts/read_markdown.py.'}}))\n        break\n\"",
            "statusMessage": "Blocking bash grep/rg; route reads through read-code/read-markdown helpers..."
          },
          {
            "type": "command",
            "command": "python3 scripts/hook_enforce_pytest_guard.py",
            "statusMessage": "Enforcing guarded pytest execution..."
          },
          {
            "type": "command",
            "command": "python3 scripts/hook_enforce_ruff_guard.py",
            "statusMessage": "Enforcing guarded ruff execution..."
          },
          {
            "type": "command",
            "command": "python3 scripts/hook_enforce_pyright_guard.py",
            "statusMessage": "Enforcing guarded pyright execution..."
          },
          {
            "type": "command",
            "command": "python3 scripts/hook_enforce_refresh_guard.py",
            "statusMessage": "Enforcing guarded refresh execution..."
          },
          {
            "type": "command",
            "command": "python3 scripts/hook_enforce_git_diff_guard.py",
            "statusMessage": "Enforcing guarded git diff execution..."
          },
          {
            "type": "command",
            "command": "python3 scripts/hook_enforce_gh_cli.py",
            "statusMessage": "Enforcing low-payload GitHub CLI policy..."
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Regex",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/vexp-guard.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook_posttool_edit_validation.py",
            "statusMessage": "Running post-edit validation and scoped refresh..."
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "codegraph": {
      "command": "uv",
      "args": [
        "run",
        "cgc",
        "mcp",
        "start"
      ],
      "cwd": "/Users/andreborczuk/app-foundation"
    },
    "codebase-lsp": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "mcp_codebase"
      ],
      "cwd": "/Users/andreborczuk/app-foundation"
    }
  }
}
