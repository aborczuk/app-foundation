{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/andreborczuk/app-foundation/.codex/hooks/session_start_context.py",
            "statusMessage": "Loading session notes and repo UV cache"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/andreborczuk/app-foundation/scripts/hook_pretool_dispatch.py",
            "statusMessage": "Running consolidated pre-tool guards..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/andreborczuk/app-foundation/scripts/hook_posttool_edit_validation.py",
            "statusMessage": "Running post-edit validation and scoped refresh..."
          }
        ]
      }
    ]
  }
}
