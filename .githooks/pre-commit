#!/usr/bin/env python3
"""Run the repo-local pre-commit lint script."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    """Dispatch to the repo-owned pre-commit lint script."""
    proc = subprocess.run(
        [sys.executable, str(REPO_ROOT / "scripts" / "git_pre_commit_lint.py")],
        cwd=REPO_ROOT,
        check=False,
    )
    return proc.returncode


if __name__ == "__main__":
    raise SystemExit(main())
